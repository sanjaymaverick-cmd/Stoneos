# Copy to apps/api/.env for local development.
# Never use production credentials here.

DATABASE_URL=postgresql://stoneos:stoneos_dev_only@127.0.0.1:5432/stoneos
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Opaque session tokens. Must be >= 32 characters in production.
SESSION_SECRET=local-dev-session-secret-not-for-production-use

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# One-time bootstrap. Destroy after the first owner exists.
BOOTSTRAP_TOKEN=local-dev-bootstrap-token-change-me
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=ChangeMeNow!12
BOOTSTRAP_OWNER_NAME=StoneOS Owner
FACTORY_NAME=Vedam Granites

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

NEXT_PUBLIC_API_URL=http://localhost:4000
