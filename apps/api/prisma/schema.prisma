generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  OWNER
  OFFICE
  YARD
}

model Factory {
  id        String          @id @default(uuid())
  name      String
  createdAt DateTime        @default(now()) @map("created_at")
  users     User[]
  accounts  MoneyAccount[]
  parties   PartyOpening[]
  items     StockItem[]
  blocks    BlockOpening[]
  slabs     SlabOpening[]
  store     StoreOpening[]
  settled   SettledTotal[]

  @@map("factory")
}

model User {
  id           String    @id @default(uuid())
  factoryId    String    @map("factory_id")
  factory      Factory   @relation(fields: [factoryId], references: [id])
  username     String    @unique
  name         String
  userType     UserType  @map("user_type")
  passwordHash String    @map("password_hash")
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@index([factoryId])
  @@map("app_user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("session")
}

enum AccountKind {
  CASH
  BANK
  UPI
}

enum PartyKind {
  CUSTOMER
  MINE
  STAFF
  ADVANCE
}

enum ItemKind {
  VARIETY
  CONSUMABLE
}

enum OpeningHead {
  CAPITAL
  CONSTRUCTION
  GST_INPUT_CLAIMED
  SUBSIDY_RECEIVED
  ICICI_PRINCIPAL_REPAID
  ICICI_INTEREST_PAID
  CC_INTEREST_PAID
  MARKET_INTEREST_PAID
  WPPF_WITHDRAWN
  PPF_WITHDRAWN
  SOLAR_PAID
}

model MoneyAccount {
  id        String      @id @default(uuid())
  factoryId String      @map("factory_id")
  factory   Factory     @relation(fields: [factoryId], references: [id])
  name      String
  kind      AccountKind
  balance   Decimal     @db.Decimal(14, 2)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([factoryId])
  @@map("money_account")
}

model PartyOpening {
  id            String    @id @default(uuid())
  factoryId     String    @map("factory_id")
  factory       Factory   @relation(fields: [factoryId], references: [id])
  name          String
  kind          PartyKind
  bankDue       Decimal   @default(0) @map("bank_due") @db.Decimal(14, 2)
  cashDue       Decimal   @default(0) @map("cash_due") @db.Decimal(14, 2)
  royaltyDue    Decimal   @default(0) @map("royalty_due") @db.Decimal(14, 2)
  transportDue  Decimal   @default(0) @map("transport_due") @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([factoryId])
  @@map("party_opening")
}

model StockItem {
  id        String         @id @default(uuid())
  factoryId String         @map("factory_id")
  factory   Factory        @relation(fields: [factoryId], references: [id])
  kind      ItemKind
  name      String
  nameKey   String         @map("name_key")
  unit      String         @default("")
  createdAt DateTime       @default(now()) @map("created_at")
  blocks    BlockOpening[]
  slabs     SlabOpening[]
  store     StoreOpening[]

  @@unique([factoryId, kind, nameKey])
  @@index([factoryId])
  @@map("stock_item")
}

model BlockOpening {
  id            String    @id @default(uuid())
  factoryId     String    @map("factory_id")
  factory       Factory   @relation(fields: [factoryId], references: [id])
  itemId        String    @map("item_id")
  item          StockItem @relation(fields: [itemId], references: [id])
  blockNumber   String    @map("block_number")
  tons          Decimal   @db.Decimal(12, 3)
  ratePerTon    Decimal   @map("rate_per_ton") @db.Decimal(14, 2)
  royaltyPerTon Decimal   @default(336) @map("royalty_per_ton") @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([factoryId])
  @@index([itemId])
  @@map("block_opening")
}

model SlabOpening {
  id          String    @id @default(uuid())
  factoryId   String    @map("factory_id")
  factory     Factory   @relation(fields: [factoryId], references: [id])
  itemId      String    @map("item_id")
  item        StockItem @relation(fields: [itemId], references: [id])
  finish      String
  sqft        Decimal   @db.Decimal(14, 2)
  ratePerSqft Decimal   @map("rate_per_sqft") @db.Decimal(14, 2)
  jobWork     Boolean   @default(false) @map("job_work")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([factoryId])
  @@index([itemId])
  @@map("slab_opening")
}

model StoreOpening {
  id        String    @id @default(uuid())
  factoryId String    @map("factory_id")
  factory   Factory   @relation(fields: [factoryId], references: [id])
  itemId    String    @map("item_id")
  item      StockItem @relation(fields: [itemId], references: [id])
  quantity  Decimal   @db.Decimal(14, 3)
  rate      Decimal   @db.Decimal(14, 2)
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([factoryId, itemId])
  @@index([factoryId])
  @@map("store_opening")
}

model SettledTotal {
  id        String      @id @default(uuid())
  factoryId String      @map("factory_id")
  factory   Factory     @relation(fields: [factoryId], references: [id])
  head      OpeningHead
  amount    Decimal     @db.Decimal(14, 2)

  @@unique([factoryId, head])
  @@map("settled_total")
}
