  factoryId     String       @map("factory_id")
  factory       Factory      @relation(fields: [factoryId], references: [id])
  invoiceId     String?      @unique @map("invoice_id")
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  creditNoteId  String?      @unique @map("credit_note_id")
  creditNote    CreditNote?  @relation(fields: [creditNoteId], references: [id])
  irn           String
  ackNo         String       @map("ack_no")
  signedQr      String       @map("signed_qr")
  status        GstDocStatus @default(mock)
  source        String       @default("mock")
  payload       Json
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([factoryId])
  @@map("e_invoice")
}

model EWayBill {
  id            String       @id @default(uuid())
  factoryId     String       @map("factory_id")
  factory       Factory      @relation(fields: [factoryId], references: [id])
  invoiceId     String?      @map("invoice_id")
  deliveryId    String?      @map("delivery_id")
  vehicleId     String?      @map("vehicle_id")
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id])
  ewbNo         String       @map("ewb_no")
  distanceKm    Int          @default(0) @map("distance_km")
  fromGstin     String?      @map("from_gstin")
  toGstin       String?      @map("to_gstin")
  fromPin       String?      @map("from_pin")
  toPin         String?      @map("to_pin")
  status        GstDocStatus @default(mock)
  source        String       @default("mock")
  clientOpId    String       @map("client_op_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@unique([factoryId, clientOpId])
  @@index([factoryId])
  @@map("e_way_bill")
}

enum WorkerKind {
  cutter
  polisher
  helper
  driver
  other
}

enum AttendanceStatus {
  present
  absent
  half
  ot
}

enum WageSheetStatus {
  draft
  confirmed
  paid
}

model Worker {
  id              String     @id @default(uuid())
  factoryId       String     @map("factory_id")
  factory         Factory    @relation(fields: [factoryId], references: [id])
  name            String
  nameKey         String     @map("name_key")
  kind            WorkerKind @default(other)
  dailyWageMinor  Int?       @map("daily_wage_minor")
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  attendance      Attendance[]
  wageLines       WageLine[]

  @@unique([factoryId, nameKey])
  @@index([factoryId])
  @@map("worker")
}

model Attendance {
  id               String            @id @default(uuid())
  factoryId        String            @map("factory_id")
  factory          Factory           @relation(fields: [factoryId], references: [id])
  workerId         String            @map("worker_id")
  worker           Worker            @relation(fields: [workerId], references: [id])
  operationalDate  DateTime          @map("operational_date") @db.Date
  status           AttendanceStatus
  otHours          Decimal?          @map("ot_hours") @db.Decimal(6, 2)
  createdAt        DateTime          @default(now()) @map("created_at")

  @@unique([workerId, operationalDate])
  @@index([factoryId, operationalDate])
  @@map("attendance")
}

model WageSheet {
  id            String          @id @default(uuid())
  factoryId     String          @map("factory_id")
  factory       Factory         @relation(fields: [factoryId], references: [id])
  periodStart   DateTime        @map("period_start") @db.Date
  periodEnd     DateTime        @map("period_end") @db.Date
  status        WageSheetStatus @default(draft)
  clientOpId    String          @map("client_op_id")
  proposedBy    String          @map("proposed_by")
  confirmedBy   String?         @map("confirmed_by")
  paidVoucherId String?         @map("paid_voucher_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  lines         WageLine[]

  @@unique([factoryId, clientOpId])
  @@index([factoryId])
  @@map("wage_sheet")
}

model WageLine {
  id           String    @id @default(uuid())
  sheetId      String    @map("sheet_id")
  sheet        WageSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  workerId     String    @map("worker_id")
  worker       Worker    @relation(fields: [workerId], references: [id])
  days         Decimal   @db.Decimal(6, 2)
  ot           Decimal   @default(0) @db.Decimal(6, 2)
  amountMinor  Int       @map("amount_minor")

  @@unique([sheetId, workerId])
  @@map("wage_line")
}

/// A charge billed alongside the slabs: packaging, demurrage, labour, handling.
/// Section 15 makes ancillary charges part of the transaction value, so these are
/// taxed with the principal supply unless explicitly marked otherwise.
model InvoiceCharge {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal  @db.Decimal(14, 2)
  /// False only for a genuine pure-agent reimbursement. Default is taxed.
  taxable   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("invoice_charge")
}

/// A counter sale settled in cash against no invoice. Stock still leaves the yard and
/// the cash is still booked, so the movement is auditable; it simply carries no GST
/// document and is therefore absent from GSTR-1. Under GST a taxable supply attracts
/// tax whether or not an invoice was raised: this records the decision, it does not
/// discharge the liability.
model CashSale {
  id           String     @id @default(uuid())
  factoryId    String     @map("factory_id")
  factory      Factory    @relation(fields: [factoryId], references: [id])
  salesOrderId String     @unique @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  buyerName    String?    @map("buyer_name")
  amount       Decimal    @db.Decimal(14, 2)
  saleDate     DateTime   @map("sale_date") @db.Date
  note         String?
  clientOpId   String     @map("client_op_id")
  recordedBy   String     @map("recorded_by")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([factoryId, clientOpId])
  @@index([factoryId, saleDate])
  @@map("cash_sale")
}

model ConsumableMovement {
  id String @id @default(uuid())
  factoryId String @map("factory_id")
  factory Factory @relation(fields: [factoryId], references: [id])
  consumableId String @map("consumable_id")
  consumable Consumable @relation(fields: [consumableId], references: [id])
  direction String
  quantity Decimal @db.Decimal(12,3)
  reason String
  occurredOn DateTime @map("occurred_on") @db.Date
  actorId String @map("actor_id")
  clientOpId String @map("client_op_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([factoryId,clientOpId])
  @@index([factoryId,occurredOn])
  @@map("consumable_movement")
}
model AnalyticsSettings {
  factoryId String @id @map("factory_id")
  factory Factory @relation(fields: [factoryId], references: [id])
  targets Json?
  openaiKeyEncrypted String? @map("openai_key_encrypted")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("analytics_settings")
}

model FinishedPurchase {
  supplierGstin          String?   @map("supplier_gstin")
  transportSupplierGstin String?   @map("transport_supplier_gstin")
  id                     String    @id @default(uuid())
  factoryId              String    @map("factory_id")
  factory                Factory   @relation(fields: [factoryId], references: [id])
  reference              String
  kind                   String
  varietyName            String    @map("variety_name")
  supplierId             String    @map("supplier_id")
  supplier               Supplier  @relation("FinishedSupplier", fields: [supplierId], references: [id])
  invoiceNo              String    @map("invoice_no")
  purchaseDate           DateTime  @map("purchase_date") @db.Date
  goodsTaxable           Decimal   @map("goods_taxable") @db.Decimal(14, 2)
  gstRatePct             Decimal   @map("gst_rate_pct") @db.Decimal(5, 2)
  cgst                   Decimal   @db.Decimal(14, 2)
  sgst                   Decimal   @db.Decimal(14, 2)
  igst                   Decimal   @db.Decimal(14, 2)
  paidAmount             Decimal   @map("paid_amount") @db.Decimal(14, 2)
  paymentMethod          String    @map("payment_method")
  transportTaxable       Decimal   @map("transport_taxable") @db.Decimal(14, 2)
  transportGstRatePct    Decimal   @map("transport_gst_rate_pct") @db.Decimal(5, 2)
  transportCgst          Decimal   @map("transport_cgst") @db.Decimal(14, 2)
  transportSgst          Decimal   @map("transport_sgst") @db.Decimal(14, 2)
  transportIgst          Decimal   @map("transport_igst") @db.Decimal(14, 2)
  transportSupplierId    String?   @map("transport_supplier_id")
  transportSupplier      Supplier? @relation("FinishedTransporter", fields: [transportSupplierId], references: [id])
  transportInvoiceNo     String?   @map("transport_invoice_no")
  transportPaidAmount    Decimal   @map("transport_paid_amount") @db.Decimal(14, 2)
  transportPaymentMethod String    @map("transport_payment_method")
  clientOpId             String    @map("client_op_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  slabs                  Slab[]

  @@unique([factoryId, reference])
  @@unique([factoryId, clientOpId])
  @@index([factoryId, purchaseDate])
  @@map("finished_purchase")
}

model OpeningBalanceBatch {
  id String @id @default(uuid())
  factoryId String @map("factory_id")
  factory Factory @relation(fields: [factoryId], references: [id])
  title String
  effectiveDate DateTime @map("effective_date") @db.Date
  note String?
  status String @default("DRAFT")
  enteredByIds Json @map("entered_by_ids")
  approvedById String? @map("approved_by_id")
  approvedAt DateTime? @map("approved_at")
  reconciled Boolean @default(false)
  clientOpId String @map("client_op_id")
  requestHash String @map("request_hash")
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  lines OpeningBalanceLine[]
  @@unique([factoryId, clientOpId])
  @@index([factoryId, status])
  @@map("opening_balance_batch")
}
model OpeningBalanceLine {
  id String @id @default(uuid())
  batchId String @map("batch_id")
  batch OpeningBalanceBatch @relation(fields: [batchId], references: [id])
  ref String
  kind String
  payload Json
  amount Decimal @default(0) @db.Decimal(14,2)
  settledAmount Decimal @default(0) @map("settled_amount") @db.Decimal(14,2)
  entityId String? @map("entity_id")
  partyId String? @map("party_id")
  settlements OpeningSettlement[]
  customerOwnedStock CustomerOwnedStock[]
  @@unique([batchId, ref])
  @@map("opening_balance_line")
}
model OpeningSettlement {
  id String @id @default(uuid())
  factoryId String @map("factory_id")
  factory Factory @relation(fields: [factoryId], references: [id])
  lineId String @map("line_id")
  line OpeningBalanceLine @relation(fields: [lineId], references: [id])
  amount Decimal @db.Decimal(14,2)
  method String
  paidAt DateTime @map("paid_at") @db.Date
  note String?
  receivedBy String? @map("received_by")
  reference String?
  pendingBucket String? @map("pending_bucket")
  clientOpId String @map("client_op_id")
  requestHash String @map("request_hash")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([factoryId,clientOpId])
  @@index([factoryId,paidAt])
  @@map("opening_settlement")
}

/// Material a customer sent for job work. Never the factory's asset: it has no ledger value
/// and is kept out of raw_block, so sales, stock valuation and reports cannot see it.
model CustomerOwnedStock {
  id String @id @default(uuid())
  factoryId String @map("factory_id")
  factory Factory @relation(fields: [factoryId], references: [id])
  lineId String? @map("line_id")
  line OpeningBalanceLine? @relation(fields: [lineId], references: [id])
  reference String
  customerName String? @map("customer_name")
  material String
  stage String
  sqft Decimal @db.Decimal(12,2)
  weightTons Decimal? @map("weight_tons") @db.Decimal(10,3)
  asOfDate DateTime @map("as_of_date") @db.Date
  note String?
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([factoryId,reference])
  @@map("customer_owned_stock")
}
