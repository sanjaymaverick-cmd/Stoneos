generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  manager
  admin
  supervisor
  operator
  inventory
  sales
  accountant
  auditor
}

enum FactoryOperatingStatus {
  SETUP
  OPENING_COUNT_IN_PROGRESS
  OPENING_PENDING_APPROVAL
  LIVE
  LOCKED
}

enum InventoryLocationType {
  RAW_YARD
  B21_QUEUE
  B21_WIP
  UNPOLISHED_STOCK
  LPM_QUEUE
  LPM_WIP
  FINISHED_STOCK
  HOLD
  PACKING
  DELIVERED
}

enum InventoryMovementType {
  OPENING_RECEIPT
  GOODS_RECEIPT
  TRANSFER
  PRODUCTION_ISSUE
  PRODUCTION_COMPLETION
  POLISHING_ISSUE
  POLISHING_COMPLETION
  SALES_RESERVATION
  RESERVATION_RELEASE
  PACKING
  DELIVERY
  DISPATCH
  RETURN
  ADJUSTMENT
  REVERSAL
}

enum OpeningSnapshotStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InventoryKind {
  RAW_BLOCK
  UNPOLISHED_SLAB
  POLISHED_SLAB
}

enum OwnershipType {
  COMPANY_OWNED
  CUSTOMER_OWNED
  CONSIGNMENT
}

enum MachineType {
  CUTTING
  POLISHING
}

enum ProductionSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum LpmProcessType {
  GRINDING
  RESIN
  POLISHING
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

/// How an order is settled. A cash sale raises no invoice and no GST document.
enum BillingMode {
  gst_invoice
  cash_unbilled
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ConflictPolicy {
  STRICT
  AUDITED_OVERWRITE
}

enum LedgerGroup {
  asset
  liability
  income
  expense
}

enum LedgerKind {
  cash
  bank
  ar
  ap
  sales
  cogs
  expense
  opening_equity
  gst
  other
}

enum PartyKind {
  customer
  supplier
  job
}

enum VoucherType {
  opening
  receipt
  payment
  contra
  journal
  sales
  credit_note
  purchase
}

enum VoucherSource {
  khata_opening
  sales_invoice
  sales_pay
  sales_cn
  cash_sale
  block_purchase
  block_purchase_cash
  expense_create
  intake_confirm
  muster_pay
  interfactory_invoice
  interfactory_settle
  copilot_journal
  stock_write_off
  manual
}

enum CashDrawerStatus {
  open
  proposed
  locked
}

enum IntakeKind {
  rokad
  dpr
  journal
  supplier_bill
  delivery_note
}

enum IntakeStatus {
  proposed
  confirmed
  rejected
  unreadable
  reviewed
}

model Factory {
  openingBalanceBatches OpeningBalanceBatch[]
  openingSettlements OpeningSettlement[]
  customerOwnedStock CustomerOwnedStock[]
  id              String                  @id @default(uuid())
  name            String
  location        String?
  operatingStatus FactoryOperatingStatus  @default(SETUP) @map("operating_status")
  goLiveDate      DateTime?               @map("go_live_date")
  createdAt       DateTime                @default(now()) @map("created_at")
  version         Int                     @default(0)

  analyticsSettings  AnalyticsSettings?
  consumableMovements ConsumableMovement[]
  users              AppUser[]
  sessions           AuthSession[]
  auditEvents        AuditEvent[]
  locations          InventoryLocation[]
  suppliers          Supplier[]
  customers          Customer[]
  machines           Machine[]
  vehicles           Vehicle[]
  finishedPurchases FinishedPurchase[]
  rawBlocks          RawBlock[]
  slabs              Slab[]
  movements          InventoryMovement[]
  openingSnapshots   OpeningInventorySnapshot[]
  stockWriteOffs     StockWriteOff[]
  cuttingSessions    CuttingSession[]
  polishingSessions  PolishingSession[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  packingLists       PackingList[]
  deliveries         Delivery[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  tallyBatches       TallyImportBatch[]
  files              StoredFile[]
  syncOps            SyncOperation[]
  consumables        Consumable[]
  maintenanceJobs    MaintenanceJob[]
  returns            CustomerReturn[]
  documentSequences  DocumentSequence[]
  creditNotes        CreditNote[]
  ledgers            Ledger[]
  parties            Party[]
  vouchers           Voucher[]
  cashDrawerDays     CashDrawerDay[]
  khataImports       KhataImportBatch[]
  intakeDrafts       IntakeDraft[]
  gstProfile         GstProfile?
  eInvoices          EInvoice[]
  eWayBills          EWayBill[]
  workers            Worker[]
  attendance         Attendance[]
  wageSheets         WageSheet[]
  cashSales          CashSale[]

  @@map("factory")
}

model AppUser {
  id                 String   @id @default(uuid())
  factoryId          String   @map("factory_id")
  factory            Factory  @relation(fields: [factoryId], references: [id])
  username           String   @unique
  email              String?  @unique
  name               String
  role               UserRole
  active             Boolean  @default(true)
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  tokenVersion       Int      @default(0) @map("token_version")
  createdAt          DateTime @default(now()) @map("created_at")
  version            Int      @default(0)

  /// Consecutive failed logins since the last success or lockout.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  /// Set while a timed lockout is in force. Login is refused until it passes.
  lockedUntil      DateTime? @map("locked_until")
  /// Timed lockouts served since the last success. The second round suspends.
  lockoutCount     Int       @default(0) @map("lockout_count")
  /// Set when repeated failures suspended the account, to tell that apart from
  /// an owner deliberately revoking someone. Both leave active = false.
  suspendedAt      DateTime? @map("suspended_at")

  sessions AuthSession[]

  @@index([factoryId])
  @@map("app_user")
}

model AuthSession {
  id        String   @id @default(uuid())
  factoryId String   @map("factory_id")
  factory   Factory  @relation(fields: [factoryId], references: [id])
  userId    String   @map("user_id")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_session")
}

model AuditEvent {
  id         String   @id @default(uuid())
  factoryId  String   @map("factory_id")
  factory    Factory  @relation(fields: [factoryId], references: [id])
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([factoryId, createdAt])
  @@map("audit_event")
}

model BootstrapLock {
  id          String   @id
  usedAt      DateTime @map("used_at")
  ownerUserId String   @map("owner_user_id")

  @@map("bootstrap_lock")
}

model InventoryLocation {
  id           String                @id @default(uuid())
  factoryId    String                @map("factory_id")
  factory      Factory               @relation(fields: [factoryId], references: [id])
  code         String
  name         String
  locationType InventoryLocationType @map("location_type")
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @map("created_at")

  rawBlocks RawBlock[]
  slabs     Slab[]

  @@unique([factoryId, code])
  @@map("inventory_location")
}

model Supplier {
  billingAddress String? @map("billing_address")
  shippingAddress String? @map("shipping_address")
  id          String     @id @default(uuid())
  factoryId   String     @map("factory_id")
  factory     Factory    @relation(fields: [factoryId], references: [id])
  name        String
  contactInfo String?    @map("contact_info")
  /// Two-digit GST state code of the place of supply for purchases from this vendor.
  stateCode   String?    @map("state_code")
  /// Without a supplier GSTIN there is no input tax credit to claim.
  gstin       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  version     Int        @default(0)
  finishedPurchases FinishedPurchase[] @relation("FinishedSupplier")
  transportedPurchases FinishedPurchase[] @relation("FinishedTransporter")
  rawBlocks   RawBlock[]

  @@index([factoryId])
  @@map("supplier")
}

model Customer {
  pendingCash Decimal @default(0) @map("pending_cash") @db.Decimal(14, 2)
  pendingBank Decimal @default(0) @map("pending_bank") @db.Decimal(14, 2)
  collectionNote String? @map("collection_note")
  id          String       @id @default(uuid())
  factoryId   String       @map("factory_id")
  factory     Factory      @relation(fields: [factoryId], references: [id])
  name        String
  contactInfo String?      @map("contact_info")
  /// Where the bill goes. The yard also needs somewhere to send the lorry, which is
  /// often a different site, so a consignee can be named per invoice as well.
  billingAddress  String?  @map("billing_address")
  shippingAddress String?  @map("shipping_address")
  /// Two-digit GST state code. Decides CGST+SGST vs IGST. Null means a local counter sale.
  stateCode   String?      @map("state_code")
  gstin       String?
  creditLimit Decimal?     @map("credit_limit") @db.Decimal(14, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  version     Int          @default(0)
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@index([factoryId])
  @@map("customer")
}

model Machine {
  id               String      @id @default(uuid())
  factoryId        String      @map("factory_id")
  factory          Factory     @relation(fields: [factoryId], references: [id])
  name             String
  machineType      MachineType @map("machine_type")
  plannedHoursPerDay Decimal? @map("planned_hours_per_day") @db.Decimal(4,2)
  idealSqftPerHour Decimal? @map("ideal_sqft_per_hour") @db.Decimal(12,3)
  bladeCount       Int?        @map("blade_count")
  headCount        Int?        @map("head_count")
  abrasivesPerHead Int?        @map("abrasives_per_head")
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @map("created_at")

  cuttingSessions   CuttingSession[]
  polishingSessions PolishingSession[]
  runtimeLogs       MachineRuntimeLog[]
  maintenanceJobs   MaintenanceJob[]

  @@index([factoryId])
  @@map("machine")
}

model RawBlock {
  openingReference String? @map("opening_reference")
  id                 String             @id @default(uuid())
  factoryId          String             @map("factory_id")
  factory            Factory            @relation(fields: [factoryId], references: [id])
  serialNumber       String             @map("serial_number")
  varietyName        String             @map("variety_name")
  supplierId         String?            @map("supplier_id")
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  quarry             String?
  weightTons         Decimal?           @map("weight_tons") @db.Decimal(10, 3)
  lengthFt           Decimal?           @map("length_ft") @db.Decimal(8, 2)
  widthFt            Decimal?           @map("width_ft") @db.Decimal(8, 2)
  heightFt           Decimal?           @map("height_ft") @db.Decimal(8, 2)
  volumeCft          Decimal?           @map("volume_cft") @db.Decimal(10, 3)
  qualityNote        String?            @map("quality_note")
  blockPricePerTon Decimal? @map("block_price_per_ton") @db.Decimal(14,2)
  royaltyPerTon Decimal? @map("royalty_per_ton") @db.Decimal(14,2)
  transportPerTon Decimal? @map("transport_per_ton") @db.Decimal(14,2)
  costsConfirmedAt   DateTime?          @map("costs_confirmed_at")
  purchaseDate       DateTime?          @map("purchase_date") @db.Date
  /// Total on the vendor bill, tax included. What is owed to the supplier.
  invoicedAmount     Decimal?           @map("invoiced_amount") @db.Decimal(14, 2)
  actualAmountPaid   Decimal?           @map("actual_amount_paid") @db.Decimal(14, 2)
  purchasePaymentMethod String?        @map("purchase_payment_method")
  /// Value before tax. This, never the tax-inclusive total, is the block's cost basis:
  /// GST paid is recoverable as input credit and is not a cost of the stone.
  purchaseTaxable    Decimal?           @map("purchase_taxable") @db.Decimal(14, 2)
  purchaseCgst       Decimal            @default(0) @map("purchase_cgst") @db.Decimal(14, 2)
  purchaseSgst       Decimal            @default(0) @map("purchase_sgst") @db.Decimal(14, 2)
  purchaseIgst       Decimal            @default(0) @map("purchase_igst") @db.Decimal(14, 2)
  /// Frozen at receipt. Rough blocks are 5% (HSN 2516), but the slab is chosen per receipt.
  purchaseGstRatePct Decimal            @default(0) @map("purchase_gst_rate_pct") @db.Decimal(5, 2)
  /// Paid in cash outside the GST bill. An unregistered quarry supplier cannot charge
  /// tax, so there is nothing to claim: this is cost of stone and carries no input
  /// credit. It sits beside purchaseTaxable in the cost basis, never inside it.
  purchaseCashAmount Decimal            @default(0) @map("purchase_cash_amount") @db.Decimal(14, 2)
  supplierInvoiceNo  String?            @map("supplier_invoice_no")
  supplierGstin      String?            @map("supplier_gstin")
  placeOfSupply      String?            @map("place_of_supply")
  ownershipType      OwnershipType      @default(COMPANY_OWNED) @map("ownership_type")
  currentStatus      String             @default("in_stock") @map("current_status")
  locationId         String?            @map("location_id")
  location           InventoryLocation? @relation(fields: [locationId], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")
  version            Int                @default(0)

  /// The lot, counted rather than labelled. The yard thinks in "VG-001 has 87 slabs
  /// left", and nobody stencils a number on every piece. Available is
  /// good - broken - sold; it is derived, never stored, so the three movements that
  /// change it cannot drift apart from a cached total.
  goodSlabCount   Int      @default(0) @map("good_slab_count")
  brokenSlabCount Int      @default(0) @map("broken_slab_count")
  soldSlabCount   Int      @default(0) @map("sold_slab_count")
  /// How many of the lot have come off the polishing line. Deliberately not part of
  /// availability: polishing changes what a slab is, not whether the yard still has
  /// it. Kept so the floor can see VG-001 has 70 left but only 50 of them finished.
  polishedSlabCount Int    @default(0) @map("polished_slab_count")
  /// Nominal finished area of one slab off this block, set when the cut is recorded.
  /// Slabs from one block are sawn to the same size, so a count converts to sqft.
  sqftPerSlab     Decimal? @map("sqft_per_slab") @db.Decimal(8, 2)

  slabs           Slab[]
  cuttingSessions CuttingSession[]
  movements       InventoryMovement[]
  openingLines    OpeningInventoryLine[]
  writeOffs       StockWriteOff[]
  salesLines      SalesLineItem[]
  deliveryLines   DeliveryLine[]
  polishingLots   PolishingSessionSlab[]

  @@unique([factoryId, serialNumber])
  @@map("raw_block")
}

/// Where a slab broke. Kept because the owner wants to know whether breakage is a
/// saw problem, a forklift problem or a loading problem.
enum WriteOffStage {
  factory_transport
  loading
  yard
  other
}

/// Slabs destroyed after they reached stock, recorded as a count against their lot.
///
/// Deliberately a row of its own rather than a silent decrement: stock leaving the
/// yard without a sale is the shape of both honest breakage and theft, so every
/// write-off names a person, a reason and a value, and posts to the ledger.
model StockWriteOff {
  id         String        @id @default(uuid())
  factoryId  String        @map("factory_id")
  factory    Factory       @relation(fields: [factoryId], references: [id])
  rawBlockId String        @map("raw_block_id")
  rawBlock   RawBlock      @relation(fields: [rawBlockId], references: [id])
  slabCount  Int           @map("slab_count")
  stage      WriteOffStage
  reason     String
  /// Valued at this block's cost per slab. Tax paid on the purchase is recoverable
  /// and is not part of what the breakage cost.
  costAmount Decimal       @default(0) @map("cost_amount") @db.Decimal(14, 2)
  occurredOn DateTime      @map("occurred_on") @db.Date
  actorId    String        @map("actor_id")
  clientOpId String        @map("client_op_id")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@unique([factoryId, clientOpId])
  @@index([factoryId, occurredOn])
  @@map("stock_write_off")
}

model Slab {
  finishedPurchaseId String? @map("finished_purchase_id")
  finishedPurchase FinishedPurchase? @relation(fields:[finishedPurchaseId],references:[id])
  purchaseCost Decimal? @map("purchase_cost") @db.Decimal(14,2)
  id               String             @id @default(uuid())
  factoryId        String             @map("factory_id")
  factory          Factory            @relation(fields: [factoryId], references: [id])
  parentBlockId    String?            @map("parent_block_id")
  parentBlock      RawBlock?          @relation(fields: [parentBlockId], references: [id])
  cuttingSessionId String?            @map("cutting_session_id")
  cuttingSession   CuttingSession?    @relation(fields: [cuttingSessionId], references: [id])
  slabSerial       String             @map("slab_serial")
  varietyName      String             @map("variety_name")
  thicknessMm      Decimal            @default(18.0) @map("thickness_mm") @db.Decimal(5, 2)
  lengthFt         Decimal?           @map("length_ft") @db.Decimal(6, 2)
  widthFt          Decimal?           @map("width_ft") @db.Decimal(6, 2)
  finish           String?
  qualityNote      String?            @map("quality_note")
  salesStatus      String             @default("in_stock") @map("sales_status")
  locationId       String?            @map("location_id")
  location         InventoryLocation? @relation(fields: [locationId], references: [id])
  createdAt        DateTime           @default(now()) @map("created_at")
  version          Int                @default(0)

  polishingLinks PolishingSessionSlab[]
  movements      InventoryMovement[]
  openingLines   OpeningInventoryLine[]
  quotationLines QuotationLine[]
  orderLines     SalesLineItem[]
  packingLines   PackingLine[]
  deliveryLines  DeliveryLine[]
  returnLines    CustomerReturnLine[]

  @@unique([factoryId, slabSerial])
  @@map("slab")
}

model InventoryMovement {
  id             String                 @id @default(uuid())
  factoryId      String                 @map("factory_id")
  factory        Factory                @relation(fields: [factoryId], references: [id])
  movementType   InventoryMovementType  @map("movement_type")
  rawBlockId     String?                @map("raw_block_id")
  rawBlock       RawBlock?              @relation(fields: [rawBlockId], references: [id])
  slabId         String?                @map("slab_id")
  slab           Slab?                  @relation(fields: [slabId], references: [id])
  quantity       Decimal                @default(1) @db.Decimal(12, 3)
  idempotencyKey String                 @map("idempotency_key")
  actorId        String?                @map("actor_id")
  notes          String?
  createdAt      DateTime               @default(now()) @map("created_at")

  @@unique([factoryId, idempotencyKey])
  @@index([factoryId, createdAt])
  @@map("inventory_movement")
}

model OpeningInventorySnapshot {
  id          String                 @id @default(uuid())
  factoryId   String                 @map("factory_id")
  factory     Factory                @relation(fields: [factoryId], references: [id])
  status      OpeningSnapshotStatus  @default(DRAFT)
  enteredById String                 @map("entered_by_id")
  approvedById String?               @map("approved_by_id")
  rejectionReason String?            @map("rejection_reason")
  createdAt   DateTime               @default(now()) @map("created_at")
  version     Int                    @default(0)
  lines       OpeningInventoryLine[]

  @@index([factoryId, status])
  @@map("opening_inventory_snapshot")
}

model OpeningInventoryLine {
  id          String                    @id @default(uuid())
  snapshotId  String                    @map("snapshot_id")
  snapshot    OpeningInventorySnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  kind        InventoryKind
  enteredById String                    @map("entered_by_id")
  rawBlockId  String?                   @map("raw_block_id")
  rawBlock    RawBlock?                 @relation(fields: [rawBlockId], references: [id])
  slabId      String?                   @map("slab_id")
  slab        Slab?                     @relation(fields: [slabId], references: [id])
  payload     Json

  @@map("opening_inventory_line")
}

model CuttingSession {
  id                 String                   @id @default(uuid())
  factoryId          String                   @map("factory_id")
  factory            Factory                  @relation(fields: [factoryId], references: [id])
  rawBlockId         String                   @map("raw_block_id")
  rawBlock           RawBlock                 @relation(fields: [rawBlockId], references: [id])
  machineId          String                   @map("machine_id")
  machine            Machine                  @relation(fields: [machineId], references: [id])
  startedAt          DateTime                 @map("started_at")
  endedAt            DateTime?                @map("ended_at")
  status             ProductionSessionStatus  @default(IN_PROGRESS)
  expectedSlabCount  Int?                     @map("expected_slab_count")
  totalSlabsCut      Int?                     @map("total_slabs_cut")
  finalGoodSlabCount Int?                     @map("final_good_slab_count")
  damagedSlabCount   Int?                     @map("damaged_slab_count")
  damagedCostAmount  Decimal?                 @map("damaged_cost_amount") @db.Decimal(14, 2)
  wastageNotes       String?                  @map("wastage_notes")
  createdAt          DateTime                 @default(now()) @map("created_at")
  version            Int                      @default(0)

  dayLogs CuttingDayLog[]
  slabs   Slab[]

  @@index([factoryId, status])
  @@map("cutting_session")
}

model CuttingDayLog {
  id                  String         @id @default(uuid())
  cuttingSessionId    String         @map("cutting_session_id")
  session             CuttingSession @relation(fields: [cuttingSessionId], references: [id])
  operationalDate     DateTime       @map("operational_date") @db.Date
  runtimeHours        Decimal?       @map("runtime_hours") @db.Decimal(4, 2)
  downtimeMinutes     Int?           @map("downtime_minutes")
  downtimeReason      String?        @map("downtime_reason")
  powerConsumptionKwh Decimal?       @map("power_consumption_kwh") @db.Decimal(10, 2)
  slabsProducedCount  Int?           @map("slabs_produced_count")
  operatorId          String?        @map("operator_id")
  notes               String?
  createdAt           DateTime       @default(now()) @map("created_at")
  version             Int            @default(0)

  @@unique([cuttingSessionId, operationalDate])
  @@map("cutting_day_log")
}

model PolishingSession {
  id                  String                  @id @default(uuid())
  factoryId           String                  @map("factory_id")
  factory             Factory                 @relation(fields: [factoryId], references: [id])
  machineId           String                  @map("machine_id")
  machine             Machine                 @relation(fields: [machineId], references: [id])
  operationalDate     DateTime                @map("operational_date") @db.Date
  processType         LpmProcessType          @map("process_type")
  finishType          String?                 @map("finish_type")
  runtimeHours        Decimal?                @map("runtime_hours") @db.Decimal(4, 2)
  downtimeMinutes     Int?                    @map("downtime_minutes")
  operatorId          String?                 @map("operator_id")
  notes               String?
  status              ProductionSessionStatus @default(IN_PROGRESS)
  createdAt           DateTime                @default(now()) @map("created_at")
  version             Int                     @default(0)

  slabs PolishingSessionSlab[]

  @@index([factoryId, operationalDate])
  @@map("polishing_session")
}

/// A line on a polishing session: either one identified slab, or a count off a lot.
///
/// The per-piece path is the older one and is untouched. A lot has no piece
/// identities at all — a cut records counts against the block and never creates Slab
/// rows — so a lot line names the block and how many of its slabs went through.
/// Exactly one of the two is set.
model PolishingSessionSlab {
  id                 String           @id @default(uuid())
  polishingSessionId String           @map("polishing_session_id")
  session            PolishingSession @relation(fields: [polishingSessionId], references: [id])
  slabId             String?          @map("slab_id")
  slab               Slab?            @relation(fields: [slabId], references: [id])
  rawBlockId         String?          @map("raw_block_id")
  rawBlock           RawBlock?        @relation(fields: [rawBlockId], references: [id])
  slabCount          Int?             @map("slab_count")

  @@unique([polishingSessionId, slabId])
  @@unique([polishingSessionId, rawBlockId])
  @@map("polishing_session_slab")
}

model MachineRuntimeLog {
  id              String   @id @default(uuid())
  machineId       String   @map("machine_id")
