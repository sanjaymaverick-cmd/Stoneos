model SalesLineItem {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  slabId       String?    @map("slab_id")
  slab         Slab?      @relation(fields: [slabId], references: [id])
  /// A lot sale names the block and how many slabs go, with no piece identities.
  /// quantitySqft is then slabCount x the block's sqftPerSlab, so invoicing and the
  /// reports keep working off area exactly as they do for a per-piece line.
  rawBlockId   String?    @map("raw_block_id")
  rawBlock     RawBlock?  @relation(fields: [rawBlockId], references: [id])
  slabCount    Int?       @map("slab_count")
  /// How many of this line's slabs have actually left the gate. The sale already
  /// deducted them from stock, so this tracks fulfilment, never availability —
  /// which is why a dispatch must not touch the lot counts a second time.
  dispatchedCount Int     @default(0) @map("dispatched_count")
  /// What the buyer sees on the bill, and the HSN it is classified under. Slabs are
  /// 6802, rough blocks 2516, and they attract different rates — so the code lives
  /// on the line, not the invoice, and one bill may carry both.
  description  String?
  hsnCode      String?    @map("hsn_code")
  /// Rate for this line. Null means take the invoice's rate.
  gstRatePct   Decimal?   @map("gst_rate_pct") @db.Decimal(5, 2)
  quantitySqft Decimal    @map("quantity_sqft") @db.Decimal(12, 3)
  rate         Decimal    @db.Decimal(14, 2)

  @@map("sales_line_item")
}

