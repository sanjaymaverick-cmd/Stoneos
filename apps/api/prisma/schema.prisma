}

model Invoice {
  id             String     @id @default(uuid())
  factoryId      String     @map("factory_id")
  factory        Factory    @relation(fields: [factoryId], references: [id])
  salesOrderId   String     @map("sales_order_id")
  salesOrder     SalesOrder @relation(fields: [salesOrderId], references: [id])
  customerId     String     @map("customer_id")
  customer       Customer   @relation(fields: [customerId], references: [id])
  invoiceNumber  String     @map("invoice_number")
  dueDate        DateTime?  @map("due_date") @db.Date
  promisedPaymentDate DateTime? @map("promised_payment_date") @db.Date
  collectionNote String? @map("collection_note")
  invoiceDate    DateTime?  @map("invoice_date") @db.Date
  /// Total payable: taxable value plus tax. AR and payments settle against this.
  amount         Decimal    @db.Decimal(14, 2)
  /// Value before tax: sum of quantity x rate, since rates are quoted ex-GST.
  taxableAmount  Decimal    @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount     Decimal    @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal    @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal    @default(0) @map("igst_amount") @db.Decimal(14, 2)
  /// Charges billed outside the taxable value (pure reimbursements). Added to the payable untaxed.
  exemptAmount   Decimal    @default(0) @map("exempt_amount") @db.Decimal(14, 2)
  /// Frozen at issue. Tax is a historical fact and is never recomputed from live profile rows.
  gstRatePct     Decimal    @default(0) @map("gst_rate_pct") @db.Decimal(5, 2)
  placeOfSupply  String?    @map("place_of_supply")
  supplierState  String?    @map("supplier_state")
  /// Consignee, copied onto the document at issue. A tax invoice must show where the
  /// goods actually went, and the customer's address can be edited later — a bill
  /// already given to a buyer must not change under them.
  shipToName      String?   @map("ship_to_name")
  shipToAddress   String?   @map("ship_to_address")
  shipToGstin     String?   @map("ship_to_gstin")
  shipToStateCode String?   @map("ship_to_state_code")
  /// Seller identity frozen at issue, for the same reason.
  sellerLegalName String?   @map("seller_legal_name")
  sellerGstin     String?   @map("seller_gstin")
  idempotencyKey String     @map("idempotency_key")
  createdAt      DateTime   @default(now()) @map("created_at")
  version        Int        @default(0)
  payments       Payment[]
  creditNotes    CreditNote[]
  charges        InvoiceCharge[]
  taxLines       InvoiceTaxLine[]
  eInvoice       EInvoice?

  @@index([factoryId, invoiceDate], map: "invoice_factory_date_idx")
  @@unique([factoryId, invoiceNumber])
  @@unique([factoryId, idempotencyKey])
  @@map("invoice")
}

/// One row per (HSN, rate) on an invoice: the HSN summary a tax invoice must carry,
/// and the only honest way to total a bill that mixes 18% slabs with 5% blocks.
/// The invoice's own cgst/sgst/igst columns are the sum of these.
model InvoiceTaxLine {
  id            String  @id @default(uuid())
  invoiceId     String  @map("invoice_id")
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hsnCode       String  @map("hsn_code")
  gstRatePct    Decimal @map("gst_rate_pct") @db.Decimal(5, 2)
  taxableAmount Decimal @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount    Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount    Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount    Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)

  @@unique([invoiceId, hsnCode, gstRatePct])
  @@map("invoice_tax_line")
}

