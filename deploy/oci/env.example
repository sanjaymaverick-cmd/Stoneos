# Copy to .env beside this file, fill it in, then: chmod 600 .env
#
# .env is gitignored. Nothing in here belongs in the repository — this repo is
# public, and the compose file deliberately reads every secret from here rather
# than carrying defaults the way infra/compose/docker-compose.prod.yml does.
#
# Generate each secret, do not invent one by hand:
#   openssl rand -base64 33 | tr -d /=+ | cut -c1-40

# ---- where the data lives ---------------------------------------------------
# The mounted block volume. Postgres data, uploaded files, Caddy certificates
# and local backups all sit under here.
STONEOS_DATA_DIR=/mnt/stoneos

# ---- public address ---------------------------------------------------------
# DOMAIN drives Caddy. A hostname gets automatic Let's Encrypt TLS; ":80" serves
# plain HTTP for before DNS is pointed at the box.
DOMAIN=stoneos.example.com
# PUBLIC_URL is the origin browsers use. It is baked into the web bundle at
# build time, so changing it means rebuilding the web image. No trailing slash,
# no path.
PUBLIC_URL=https://stoneos.example.com

# ---- database ---------------------------------------------------------------
POSTGRES_USER=stoneos
POSTGRES_PASSWORD=
POSTGRES_DB=stoneos
# Host is the compose service name; the database is not published to the host.
DATABASE_URL=postgresql://stoneos:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/stoneos

# ---- application ------------------------------------------------------------
# At least 32 characters, not a placeholder, or the API refuses to start in
# production (apps/api/src/config.ts).
SESSION_SECRET=
TZ=Asia/Kolkata

# ---- one-time bootstrap -----------------------------------------------------
# Creates the factory and the first owner login. DELETE these three lines from
# .env once the owner exists and has changed the password. The CLI refuses to
# run twice regardless (a bootstrap_lock row), but the password should not sit
# on disk afterwards.
BOOTSTRAP_TOKEN=
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=StoneOS Owner
FACTORY_NAME=Vedam Granites

# ---- backups ----------------------------------------------------------------
# An OCI Object Storage pre-authenticated request with object-WRITE permission,
# ending in a slash. A PAR rather than the oci CLI on purpose: no SDK to
# install, no API signing key on the box, and it can be revoked on its own from
# the console.
#
# Leave it empty and backups stay on this box only, which is not a backup.
STONEOS_BACKUP_PAR_URL=
STONEOS_BACKUP_RETAIN_DAYS=14
